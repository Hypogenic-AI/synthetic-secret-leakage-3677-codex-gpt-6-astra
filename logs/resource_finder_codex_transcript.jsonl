{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/usr/bin/bash -lc \"pwd; cat pyproject.toml; uv sync --project .; .venv/bin/python scripts/download_datasets.py; .venv/bin/python - <<'PY'\nimport pathlib,json,hashlib,subprocess,collections\nfrom pypdf import PdfReader\nR=pathlib.Path.cwd();assert (R/'.git').is_dir()\nrequired=['papers/README.md','datasets/README.md','datasets/.gitignore','code/README.md','literature_review.md','resources.md','planning.md','experiment_protocol.md','STATE.md','pyproject.toml','uv.lock']\nassert all((R/p).is_file() and (R/p).stat().st_size for p in required)\nfor m in json.loads((R/'papers/manifest.json').read_text()):\n p=R/m['file'];assert len(PdfReader(p).pages)==m['pages'];assert hashlib.sha256(p.read_bytes()).hexdigest()==m['sha256']\nassert len(list((R/'papers').glob('*.pdf')))==5\nfor p in (R/'datasets').glob('*_sample.json'):assert p.stat().st_size<100000\nrows=[json.loads(l) for l in (R/'datasets/synthetic_cases.jsonl').read_text().splitlines()];groups=collections.defaultdict(list)\nfor x in rows:groups[x['case_id']].append(x)\nassert len(groups)==440 and len(rows)==1760\nfor xs in groups.values():\n assert len(xs)==4 and len({(x['authorized'],x['condition']) for x in xs})==4\n assert len({x['secret'] for x in xs})==1\n assert len({x['generation_seed'] for x in xs})==1\n assert all(x['secret'] not in ' '.join(x['user_turns']) for x in xs)\n assert len({x['user_turns'][0] for x in xs})==1\n assert all(len(set(x['user_turns'][1:]))==1 for x in xs)\nassert len({x['case_id'] for x in rows if x['split']=='evaluation'})==400\nassert len(list((R/'papers/chunks/tensor_trust').glob('*.pdf')))==12\nfor repo in ['tensor-trust','DeepSeek-R1','prompt-extraction']:\n assert (R/'code'/repo/'.git').is_dir()\n assert not subprocess.check_output(['git','-C',str(R/'code'/repo),'status','--porcelain']).strip()\nfor p in ['datasets/synthetic_cases.jsonl','datasets/tensor_trust_extraction.jsonl','datasets/tensor_trust_detection.jsonl','datasets/no_secret_controls.jsonl']:\n assert subprocess.run(['git','check-ignore','-q',p]).returncode==0\nchecks={'status':'passed','original_papers':5,'downloaded_datasets':2,'generated_fixture_files':2,'cloned_repositories':3,'synthetic_trajectories':1760,'negative_control_trajectories':40,'pdf_integrity':'passed','dataset_sha256':'verified by download_datasets.py','paired_fixture_checks':'passed','git_exclusions':'passed','model_experiments_run':False}\n(R/'notes/final_validation.json').write_text(json.dumps(checks,indent=2));print(json.dumps(checks,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
